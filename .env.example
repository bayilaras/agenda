# Development defaults. Demo contains synthetic data and requires explicit entry.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
DEMO_MODE=true
DATA_DIR=./data
# Development uses Vite's /api proxy. Production must use an HTTPS public URL.
APP_BASE_URL=http://localhost:5173

# Production: base64-encoded random 32-byte key; store in secret manager, never commit.
# In development only, a generated key is stored at ~/.pesan-agenda/development.key.
# ENCRYPTION_KEY=

# Server-only configuration JSON file, outside the public directory/repository.
# Personal use: one owner account and your leader/calendar profiles (see README).
# APP_CONFIG_FILE=C:/secure/pesan-agenda/config.json
# APP_CONFIG_JSON can be used instead. See README for the exact schema.

# Real Google Calendar integration, managed by your configured owner account.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/google/callback
